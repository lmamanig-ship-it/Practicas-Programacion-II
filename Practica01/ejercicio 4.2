import math 
class Estadistica:
    def __init__(self, datos):
        self.datos = datos
    def promedio(self):
        suma = 0

        for numero in self.datos:
            suma = suma + numero
        return suma / 10
    def desviacion(self):
        prom = self.promedio()
        suma = 0

        for numero in self. datos:
            suma = suma + (numero - prom) ** 2
        resultado = suma / 9
        return math.sqrt(resultado)
# principal
datos = []

print("Ingrese 10 números:")

for i in range(10):
    numero =float(input())
    datos.append(numero)
estadistica = Estadistica(datos)

print("El promedio es:", round(estadistica.promedio(),2))
print("La desviacion estándar es:", round (estadistica.desviacion(),5))